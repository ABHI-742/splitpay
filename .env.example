# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://splitpay:splitpay@localhost:5432/splitpay
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173

# RS256 key pair for access tokens. Generate with:
#   node -e "const k=require('crypto').generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('JWT_PRIVATE_KEY=\"'+k.privateKey.trim().replace(/\n/g,'\\\\n')+'\"\nJWT_PUBLIC_KEY=\"'+k.publicKey.trim().replace(/\n/g,'\\\\n')+'\"')"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Stripe TEST-mode keys only (the API refuses live keys).
# Webhook secret: run `stripe listen --forward-to localhost:4000/webhooks/stripe` and copy the whsec_ value.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
