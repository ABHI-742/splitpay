# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://splitpay:splitpay@localhost:5432/splitpay
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173

# Generate a key pair: openssl genpkey -algorithm RSA -out jwt.key && openssl rsa -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Stripe TEST-mode keys only (the API refuses live keys)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
