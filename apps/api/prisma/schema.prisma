// Data model for SplitPay (docs/diagrams/er-diagram.md).
// All money columns are integer minor units (ADR-0001).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}

enum SplitMethod {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum SettlementStatus {
  SUGGESTED
  PENDING
  PAID
  RECORDED_CASH
  EXPIRED
  FAILED
  REFUNDED
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  passwordHash        String
  createdAt           DateTime       @default(now())
  memberships         Membership[]
  expensesPaid        Expense[]      @relation("PaidBy")
  splits              ExpenseSplit[]
  settlementsSent     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  activities          Activity[]
}

model Group {
  id                String             @id @default(cuid())
  name              String
  currency          String             @default("USD") @db.Char(3)
  createdAt         DateTime           @default(now())
  memberships       Membership[]
  expenses          Expense[]
  settlements       Settlement[]
  recurringExpenses RecurringExpense[]
  activities        Activity[]
  invites           Invite[]
}

model Membership {
  userId   String
  groupId  String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model Expense {
  id             String         @id @default(cuid())
  groupId        String
  paidById       String
  description    String
  amountMinor    Int
  splitMethod    SplitMethod
  incurredOn     DateTime       @db.Date
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy         User           @relation("PaidBy", fields: [paidById], references: [id])
  splits         ExpenseSplit[]

  @@index([groupId, incurredOn])
}

model ExpenseSplit {
  expenseId   String
  userId      String
  amountMinor Int
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id              String           @id @default(cuid())
  groupId         String
  fromUserId      String
  toUserId        String
  amountMinor     Int
  status          SettlementStatus @default(SUGGESTED)
  stripeSessionId String?          @unique
  stripeEventId   String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser        User             @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser          User             @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([groupId, status])
}

model RecurringExpense {
  id          String      @id @default(cuid())
  groupId     String
  paidById    String
  description String
  amountMinor Int
  splitMethod SplitMethod @default(EQUAL)
  cron        String
  active      Boolean     @default(true)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Activity {
  id      String   @id @default(cuid())
  groupId String
  actorId String
  type    String
  payload Json
  at      DateTime @default(now())
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor   User     @relation(fields: [actorId], references: [id])

  @@index([groupId, at])
}

model Invite {
  token     String   @id
  groupId   String
  expiresAt DateTime
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}
